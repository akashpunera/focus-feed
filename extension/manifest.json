{
  "manifest_version": 3,
  "name": "Focus Feed",
  "version": "1.1.0",
  "description": "Teach Safari which X and YouTube Home posts you want to see.",
  "permissions": [
    "storage",
    "declarativeNetRequest"
  ],
  "host_permissions": [
    "https://x.com/*",
    "https://www.youtube.com/*"
  ],
  "action": {
    "default_popup": "settings.html",
    "default_title": "Focus Feed"
  },
  "content_scripts": [
    {
      "matches": [
        "https://x.com/*",
        "https://www.youtube.com/*"
      ],
      "js": [
        "policy.js",
        "feed.js"
      ],
      "css": [
        "feed.css"
      ],
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://www.youtube.com/*"
      ],
      "js": [
        "youtube-player.js"
      ],
      "css": [
        "youtube-player.css"
      ],
      "run_at": "document_start"
    }
  ],
  "declarative_net_request": {
    "rule_resources": [
      {
        "id": "youtube_ads",
        "enabled": true,
        "path": "youtube-ads.json"
      }
    ]
  }
}
